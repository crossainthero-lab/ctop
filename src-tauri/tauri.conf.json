{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CtoP",
  "version": "0.1.0",
  "identifier": "dev.ctop.app",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CtoP",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Graphics",
    "shortDescription": "Computer to Pencil — write on paper with a pencil plotter",
    "longDescription": "CtoP writes typed text onto paper with a pencil plotter: a camera finds the paper and its ruled lines, and the text is placed exactly where it will be written.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": { "deb": { "depends": ["fonts-dejavu-core"] } }
  }
}
