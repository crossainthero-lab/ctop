{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CtoP",
  "version": "0.1.0",
  "identifier": "dev.ctop.app",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CtoP — Computer to Pencil",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Graphics",
    "shortDescription": "Computer to Pencil — pencil plotter controller",
    "longDescription": "CtoP turns a Marlin 3D printer with a pencil on the print head into a writing, drawing and plotting machine.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": { "deb": { "depends": ["fonts-dejavu-core"] } }
  }
}
